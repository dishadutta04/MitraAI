<mxfile host="app.diagrams.net"><diagram name="Mitra AI"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Mitra AI: how it works (October 2026)" style="text;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-45" y="-70" width="900" height="40" as="geometry"/></mxCell><mxCell id="laneA" value="1. Opening &amp; sign-in" style="swimlane;startSize=40;fontSize=16;fontStyle=1;fillColor=#f8f9fa;strokeColor=#ced4da;rounded=1;" vertex="1" parent="1"><mxGeometry x="-45" y="40" width="360" height="676" as="geometry"/></mxCell><mxCell id="laneB" value="2. Profile setup (first time only)" style="swimlane;startSize=40;fontSize=16;fontStyle=1;fillColor=#f8f9fa;strokeColor=#ced4da;rounded=1;" vertex="1" parent="1"><mxGeometry x="375" y="40" width="360" height="976" as="geometry"/></mxCell><mxCell id="laneC" value="3. Ordering" style="swimlane;startSize=40;fontSize=16;fontStyle=1;fillColor=#f8f9fa;strokeColor=#ced4da;rounded=1;" vertex="1" parent="1"><mxGeometry x="795" y="40" width="360" height="1276" as="geometry"/></mxCell><mxCell id="laneD" value="4. Checkout &amp; after" style="swimlane;startSize=40;fontSize=16;fontStyle=1;fillColor=#f8f9fa;strokeColor=#ced4da;rounded=1;" vertex="1" parent="1"><mxGeometry x="1215" y="40" width="360" height="1426" as="geometry"/></mxCell><mxCell id="A0" value="Open Mitra AI" style="ellipse;whiteSpace=wrap;html=0;fontSize=13;fillColor=#eebefa;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="0" y="140" width="270" height="92" as="geometry"/></mxCell><mxCell id="A1" value="Splash screen&#xa;Pixel-M logo animation&#xa;(plays on every refresh)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#b2f2bb;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="0" y="290" width="270" height="92" as="geometry"/></mxCell><mxCell id="A2" value="Sign in / Sign up&#xa;Email or Google (Clerk)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#b2f2bb;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="0" y="440" width="270" height="92" as="geometry"/></mxCell><mxCell id="A3" value="First time?" style="rhombus;whiteSpace=wrap;html=0;fontSize=13;fillColor=#b2f2bb;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="0" y="590" width="270" height="92" as="geometry"/></mxCell><mxCell id="B0" value="1. Language&#xa;Hinglish / Hindi / English" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#b2f2bb;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="420" y="140" width="270" height="92" as="geometry"/></mxCell><mxCell id="B1" value="2. Your details&#xa;Name, age, mobile number,&#xa;email, address, stores, payment" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#b2f2bb;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="420" y="290" width="270" height="92" as="geometry"/></mxCell><mxCell id="B2" value="3. Health&#xa;Diabetes, BP, kidney,&#xa;medicines, allergies, diet notes" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#b2f2bb;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="420" y="440" width="270" height="92" as="geometry"/></mxCell><mxCell id="B3" value="4. Family &amp; alerts&#xa;Family contacts +&#xa;SMS / email on or off" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#b2f2bb;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="420" y="590" width="270" height="92" as="geometry"/></mxCell><mxCell id="B4" value="5. Voice&#xa;Mic test, Roman / Devanagari,&#xa;read replies aloud" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#b2f2bb;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="420" y="740" width="270" height="92" as="geometry"/></mxCell><mxCell id="B5" value="Saved to your profile&#xa;(Supabase database)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#fff3bf;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="420" y="890" width="270" height="92" as="geometry"/></mxCell><mxCell id="C0" value="Home: Assistant&#xa;Speak or type the order" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#b2f2bb;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="840" y="140" width="270" height="92" as="geometry"/></mxCell><mxCell id="C1" value="&quot;Mitra understood&quot; card&#xa;Check items, fix quantities" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#b2f2bb;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="840" y="290" width="270" height="92" as="geometry"/></mxCell><mxCell id="C2" value="Understands the order&#xa;(Intent agent)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#b2f2bb;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="840" y="440" width="270" height="92" as="geometry"/></mxCell><mxCell id="C3" value="Health check&#xa;Against YOUR health profile" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#b2f2bb;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="840" y="590" width="270" height="92" as="geometry"/></mxCell><mxCell id="C4" value="Risky for you?" style="rhombus;whiteSpace=wrap;html=0;fontSize=13;fillColor=#b2f2bb;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="840" y="740" width="270" height="92" as="geometry"/></mxCell><mxCell id="CX" value="Warning + healthier options&#xa;Safer quantity" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#b2f2bb;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="840" y="890" width="270" height="92" as="geometry"/></mxCell><mxCell id="C5" value="Search stores&#xa;Zepto + Amazon (demo list)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#fff3bf;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="840" y="1040" width="270" height="92" as="geometry"/></mxCell><mxCell id="C6" value="Compare price, time, stock&#xa;Best option picked first" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#b2f2bb;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="840" y="1190" width="270" height="92" as="geometry"/></mxCell><mxCell id="D0" value="Confirmation screen&#xa;Pick options, payment,&#xa;delivery address" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#b2f2bb;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="1260" y="140" width="270" height="92" as="geometry"/></mxCell><mxCell id="D1" value="Approve?" style="rhombus;whiteSpace=wrap;html=0;fontSize=13;fillColor=#b2f2bb;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="1260" y="290" width="270" height="92" as="geometry"/></mxCell><mxCell id="D2" value="Pay now?" style="rhombus;whiteSpace=wrap;html=0;fontSize=13;fillColor=#b2f2bb;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="1260" y="440" width="270" height="92" as="geometry"/></mxCell><mxCell id="D3" value="Pay online (Razorpay)&#xa;UPI / card, payment checked" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#a5d8ff;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="1260" y="590" width="270" height="92" as="geometry"/></mxCell><mxCell id="D4" value="Place the order&#xa;(refund if it fails after paying)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#fff3bf;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="1260" y="740" width="270" height="92" as="geometry"/></mxCell><mxCell id="D5" value="Alerts sent&#xa;SMS + email to you and family" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#a5d8ff;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="1260" y="890" width="270" height="92" as="geometry"/></mxCell><mxCell id="D6" value="Order history&#xa;Saved for every device" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#b2f2bb;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="1260" y="1040" width="270" height="92" as="geometry"/></mxCell><mxCell id="D7" value="Order again&#xa;(one tap)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#b2f2bb;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="1260" y="1190" width="270" height="92" as="geometry"/></mxCell><mxCell id="D8" value="Delivery tracking" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#ffd8a8;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="1260" y="1340" width="270" height="92" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="A0" target="A1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="A1" target="A2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="A2" target="A3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="A3" target="B0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="No, welcome back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="A3" target="C0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="B0" target="B1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="B1" target="B2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="B2" target="B3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="B3" target="B4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="B4" target="B5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="B5" target="C0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="C0" target="C1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="Looks right, send" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="C1" target="C2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="C2" target="C3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="C3" target="C4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="C4" target="CX"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="C4" target="C5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="Keep or switch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="CX" target="C5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="C5" target="C6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="C6" target="D0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="D0" target="D1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="No: edit or cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="D1" target="C1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="D1" target="D2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="D2" target="D3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="Cash / UPI on delivery" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="D2" target="D4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="Paid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="D3" target="D4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="D4" target="D5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="D5" target="D6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="D6" target="D7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="Order again" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="D7" target="C0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;" edge="1" parent="1" source="D6" target="D8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="your health info" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;dashed=1;strokeColor=#868e96;" edge="1" parent="1" source="B2" target="C3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="your family contacts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;endArrow=block;dashed=1;strokeColor=#868e96;" edge="1" parent="1" source="B3" target="D5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legT" value="Colour key" style="text;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1790" y="40" width="300" height="30" as="geometry"/></mxCell><mxCell id="leg0" value="Done and working" style="rounded=1;fontSize=13;fillColor=#b2f2bb;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="1790" y="80" width="340" height="40" as="geometry"/></mxCell><mxCell id="leg1" value="Built: needs your keys to go live" style="rounded=1;fontSize=13;fillColor=#a5d8ff;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="1790" y="132" width="340" height="40" as="geometry"/></mxCell><mxCell id="leg2" value="Works, but demo / setup pending" style="rounded=1;fontSize=13;fillColor=#fff3bf;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="1790" y="184" width="340" height="40" as="geometry"/></mxCell><mxCell id="leg3" value="Not built yet" style="rounded=1;fontSize=13;fillColor=#ffd8a8;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="1790" y="236" width="340" height="40" as="geometry"/></mxCell><mxCell id="leg4" value="Start" style="rounded=1;fontSize=13;fillColor=#eebefa;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="1790" y="288" width="340" height="40" as="geometry"/></mxCell><mxCell id="pan0" value="Progress (estimate)&#xa;&#xa;Working demo:  about 84%&#xa;Real product:  about 60%&#xa;&#xa;Done: logo &amp; splash, sign-in, profile setup,&#xa;voice, order understanding, health checks,&#xa;confirmation, order history, order again&#xa;Built, needs keys: online payment, SMS &amp; email&#xa;Demo only: store search, placing real orders&#xa;Not built: delivery tracking, hosting online" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fontSize=13;fillColor=#ffffff;strokeColor=#adb5bd;" vertex="1" parent="1"><mxGeometry x="1790" y="360" width="420" height="268" as="geometry"/></mxCell><mxCell id="pan1" value="Services used (in plain words)&#xa;&#xa;Clerk: sign-in and accounts&#xa;Supabase: database for profiles and orders&#xa;Razorpay: online payment (UPI / card)&#xa;Resend: order emails&#xa;Twilio: order SMS&#xa;Browser + offline speech: voice to text&#xa;Redis: live 'agents at work' view" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fontSize=13;fillColor=#ffffff;strokeColor=#adb5bd;" vertex="1" parent="1"><mxGeometry x="1790" y="652" width="420" height="224" as="geometry"/></mxCell><mxCell id="pan2" value="Your to-do list&#xa;&#xa;1. Add Supabase database password&#xa;2. Clerk: make phone optional at sign-up,&#xa;    rename app to &quot;Mitra AI&quot;&#xa;3. Add Razorpay test keys&#xa;4. Add Resend (email) and Twilio (SMS) keys&#xa;5. Start Redis for the live agent view&#xa;6. Save work to GitHub (54 files waiting)" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fontSize=13;fillColor=#ffffff;strokeColor=#adb5bd;" vertex="1" parent="1"><mxGeometry x="1790" y="900" width="420" height="224" as="geometry"/></mxCell><mxCell id="pan3" value="Safety built in&#xa;&#xa;Nothing is bought without your OK&#xa;Health warnings use your own profile&#xa;Amount to pay is set by the server&#xa;Money refunded if the order fails&#xa;Each user sees only their own orders&#xa;Health data hidden from public access" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fontSize=13;fillColor=#ffffff;strokeColor=#adb5bd;" vertex="1" parent="1"><mxGeometry x="1790" y="1148" width="420" height="202" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>