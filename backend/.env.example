# Mitra AI backend settings. Copy to backend/.env and fill in; backend/.env is never committed.

# ---------- Database (Supabase) ----------
# Supabase → your project → Connect → Session pooler → copy the URI and put your database
# password in it (special characters: @ → %40, # → %23, / → %2F, : → %3A).
# Leave it commented out to use a local SQLite file (backend/mitra_ai.db).
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional, for reference only (the backend talks to the database directly via DATABASE_URL):
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---------- Sign-in (Clerk) ----------
# The same publishable key as the frontend. The backend uses it to find your Clerk app's
# signing keys and check every request's session token. (No secret key is needed here.)
CLERK_PUBLISHABLE_KEY=pk_test_...
# Sites allowed to use the session tokens (comma-separated), e.g. http://localhost:3000,https://mitra.example.com
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# ---------- Online payment (Razorpay) ----------
# dashboard.razorpay.com → Account & Settings → API Keys. Test keys (rzp_test_...) take no real money.
# Leave empty and "Pay now" is hidden; cash / UPI on delivery still work.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------- Order alerts ----------
# Email via Resend (resend.com → API Keys). Until you verify your own domain, Resend only delivers
# from onboarding@resend.dev to the email address you signed up to Resend with.
RESEND_API_KEY=
ALERT_EMAIL_FROM=Mitra AI <onboarding@resend.dev>
# SMS via Twilio (console.twilio.com → Account Info). A trial account only texts numbers you've
# verified in the console; Indian numbers in production also need DLT registration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Live agent timeline (Redis) ----------
# redis://localhost:6379/0 when running locally; docker-compose sets redis://redis:6379/0 itself.
REDIS_URL=redis://localhost:6379/0

# ---------- AI ----------
# "mock" = built-in rules (no key needed); "openai" uses OPENAI_API_KEY.
LLM_PROVIDER=mock
OPENAI_API_KEY=

# ---------- Voice ----------
# Offline Vosk speech models (Hindi + Indian English) for browsers without built-in speech recognition.
VOSK_MODELS_DIR=models
